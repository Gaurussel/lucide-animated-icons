{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!dist", "!demo/dist", "!src/icons/index.ts", "!src/loaders.ts"]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/createAnimatedIcon.tsx", "src/dynamic.tsx", "test/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		}
	],
	"yaml": {
		"formatter": {
			"indentWidth": 2
		}
	}
}
