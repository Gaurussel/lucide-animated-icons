{
	"name": "lucide-animated-icons",
	"version": "0.1.0",
	"description": "Hover animations for every Lucide icon, built on Motion for React",
	"license": "ISC",
	"author": "Nikita Voronov",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gaurussel/lucide-animated-icons.git"
	},
	"homepage": "https://gaurussel.github.io/lucide-animated-icons/",
	"bugs": "https://github.com/Gaurussel/lucide-animated-icons/issues",
	"type": "module",
	"sideEffects": false,
	"keywords": [
		"lucide",
		"icons",
		"animated",
		"motion",
		"react",
		"svg"
	],
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./icons/*": {
			"types": "./dist/icons/*.d.ts",
			"default": "./dist/icons/*.js"
		},
		"./dynamic": {
			"types": "./dist/dynamic.d.ts",
			"default": "./dist/dynamic.js"
		},
		"./helpers": {
			"types": "./dist/helpers.d.ts",
			"default": "./dist/helpers.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate": "bun scripts/generate.ts",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"demo": "vite demo",
		"demo:build": "vite build demo",
		"measure": "bun scripts/measure-motion.ts",
		"prepublishOnly": "bun run generate --check && bun run typecheck && bun run lint && bun run test && bun run build"
	},
	"peerDependencies": {
		"motion": "^14.9.0",
		"react": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^30.1.3",
		"lucide-react": "0.525.0",
		"playwright": "^1.64.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
